<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="一级市场情绪指数" Width="1080" Height="780" MinWidth="800" MinHeight="560" WindowStyle="None" ResizeMode="CanResize" Background="#111210" WindowStartupLocation="CenterScreen" Foreground="#EEEAE1" UseLayoutRounding="True">
 <Border BorderBrush="#34362E" BorderThickness="1" CornerRadius="12" Background="{DynamicResource Background}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="24,0,8,0" LastChildFill="False">
    <TextBlock Text="PRIMARY MARKET  /  SENTIMENT" FontFamily="Times New Roman" Foreground="#C6AB73" FontSize="11" VerticalAlignment="Center"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button x:Name="MinimizeButton" Width="38" MinHeight="30" Padding="0" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M 0,5 L 10,5" Stroke="#AAA89D" StrokeThickness="1"/></Button>
      <Button x:Name="MaximizeButton" Width="38" MinHeight="30" Padding="0" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原"><Path Data="M 0,0 L 9,0 L 9,9 L 0,9 Z" Stroke="#AAA89D" StrokeThickness="1"/></Button>
      <Button x:Name="CloseButton" Width="38" MinHeight="30" Padding="0" ToolTip="关闭" AutomationProperties.Name="关闭"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#AAA89D" StrokeThickness="1"/></Button>
    </StackPanel>
   </DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
   <StackPanel x:Name="Page" Margin="32,17,32,21">
    <Grid Margin="0,0,0,27"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="一级市场情绪指数" FontSize="32" Margin="0,0,0,7"/><TextBlock Text="发行定价、利差分布与每日市场情绪" Foreground="{DynamicResource Muted}" FontSize="14"/></StackPanel>
     <Button x:Name="SettingsButton" Grid.Column="1" VerticalAlignment="Center" Padding="13,10"><StackPanel Orientation="Horizontal"><Path Data="M 0,3 L 16,3 M 0,11 L 16,11 M 5,0 L 5,6 M 11,8 L 11,14" Stroke="#AAA89D" StrokeThickness="1.2" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
    </Grid>
    <Grid x:Name="Cards"><Grid.ColumnDefinitions><ColumnDefinition Width="1.18*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border x:Name="TaskCard" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="24" MinHeight="420">
      <StackPanel>
       <DockPanel Margin="0,0,0,22"><TextBlock Text="生成报告" FontSize="18"/><TextBlock x:Name="TaskBadge" Text="待运行" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{DynamicResource Small}" VerticalAlignment="Center"/></DockPanel>
       <Border Background="{DynamicResource Deep}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
        <StackPanel>
         <Grid Margin="15,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="数据日期" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button x:Name="DateButton" Grid.Column="1" HorizontalAlignment="Right" Padding="10,6" FontFamily="Times New Roman" FontSize="17" Content="—" ToolTip="选择DM数据所属日期"/></Grid>
         <Border Height="1" Background="{DynamicResource Line}"/>
         <Grid Margin="15,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="保存位置" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><Button x:Name="FolderButton" Grid.Column="1" HorizontalAlignment="Right" MaxWidth="270" Padding="9,6"><StackPanel Orientation="Horizontal"><Path Data="M 0,3 L 0,12 L 16,12 L 16,2 L 7,2 L 5,0 L 0,0 Z" Stroke="#C6AB73" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock x:Name="FolderLabel" Text="桌面" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="›" FontFamily="Times New Roman" Margin="9,0,0,0"/></StackPanel></Button></Grid>
        </StackPanel>
       </Border>
       <WrapPanel Margin="0,16,0,21">
        <TextBlock x:Name="DmState" Text="●  DM · 待验证" Style="{DynamicResource Small}" Margin="0,0,18,0"/>
        <TextBlock x:Name="DqState" Text="●  DQ · 待验证" Style="{DynamicResource Small}" Margin="0,0,18,0"/>
        <TextBlock x:Name="WindState" Text="●  Wind · 待验证" Style="{DynamicResource Small}"/>
       </WrapPanel>
       <Button x:Name="GenerateButton" Style="{DynamicResource Primary}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="GenerateLabel" Text="生成当日报告" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="16"/><Path Data="M 0,5 L 15,5 M 10,0 L 15,5 L 10,10" Stroke="#181A14" StrokeThickness="1.2" Margin="15,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
       <Grid Margin="0,14,0,0" MinHeight="38"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="运行时自动检查软件与插件" Style="{DynamicResource Small}" VerticalAlignment="Center" LineHeight="20"/><Button x:Name="StopButton" Content="停止任务" Grid.Column="1" Padding="10,3,0,3" MinHeight="28" FontSize="12" Foreground="{DynamicResource Ink}" Visibility="Collapsed" Margin="5,0,0,0"/></Grid>
       <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,17"/>
       <UniformGrid Columns="4" x:Name="Steps"/>
      </StackPanel>
     </Border>
     <Border x:Name="ResultCard" Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="24" MinHeight="420">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,23"><TextBlock Text="最近报告" FontSize="18"/><TextBlock x:Name="ResultDate" Text="尚无报告" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{DynamicResource Small}" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Grid.Row="1" Text="价格情绪指数" Foreground="{DynamicResource Muted}" FontSize="13"/>
       <TextBlock Grid.Row="2" x:Name="IndexValue" Text="—" FontFamily="Times New Roman" FontSize="66" Foreground="{DynamicResource Gold}" Margin="-2,1,0,0"/>
       <WrapPanel Grid.Row="3" Margin="0,3,0,21"><TextBlock Text="有效样本 " Style="{DynamicResource Small}"/><TextBlock x:Name="SampleCount" Text="—" FontFamily="Times New Roman" FontSize="16" Margin="4,-2,5,0"/><TextBlock Text="只" Style="{DynamicResource Small}" Margin="0,0,20,0"/><TextBlock Text="旧口径 " Style="{DynamicResource Small}"/><TextBlock x:Name="OldIndex" Text="—" FontFamily="Times New Roman" FontSize="16" Margin="4,-2,0,0"/></WrapPanel>
       <StackPanel Grid.Row="5">
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,13"/>
        <UniformGrid Columns="3"><Button x:Name="ExcelButton" Content="数据表" ToolTip="打开五页Excel报告" Foreground="{DynamicResource Gold}" Background="#25251D"/><Button x:Name="TextButton" Content="汇报文字" ToolTip="打开TXT汇报文字"/><Button x:Name="ImageButton" Content="汇报图片" ToolTip="打开原样式汇报图片"/></UniformGrid>
        <TextBlock x:Name="ResultNote" Text="完成后可查看五页数据表、汇报文字及图片。" Style="{DynamicResource Small}" Margin="0,13,0,13" LineHeight="20" MinHeight="40"/>
        <DockPanel><TextBlock x:Name="ResultKind" Text="" Style="{DynamicResource Small}" VerticalAlignment="Center"/><Button x:Name="OpenFolderButton" Content="打开文件夹  ↗" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" MinHeight="28" Padding="8,4,0,4" Foreground="{DynamicResource Ink}"/></DockPanel>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,18,0,0" Padding="18,14">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0"><TextBlock Text="历史交接" FontSize="15" Margin="0,0,0,5"/><TextBlock x:Name="HistorySummary" Text="月末导出完整历史，接手时导入补齐。" Style="{DynamicResource Small}" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ImportHistoryButton" Content="导入历史" Padding="13,8" Margin="0,0,8,0" ToolTip="补齐缺失日期，同日记录保留本机值"/><Button x:Name="ExportHistoryButton" Content="导出历史" Padding="13,8" Foreground="{DynamicResource Gold}" Background="#25251D" ToolTip="导出完整汇总历史，交接给下月同事"/></StackPanel>
     </Grid>
    </Border>
    <Border Background="{DynamicResource Deep}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,20,0,0">
     <Expander x:Name="LogExpander" Header="运行记录"><StackPanel><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="138" Background="Transparent" BorderThickness="0" Padding="15,4,15,10" FontSize="12"/><DockPanel Margin="8,0,8,7"><Button x:Name="LogFolderButton" Content="打开本次过程记录" FontSize="12" MinHeight="30" Padding="8,4"/><Button x:Name="CopyLogButton" Content="复制记录" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="12" MinHeight="30" Padding="8,4"/></DockPanel></StackPanel></Expander>
    </Border>
    <TextBlock x:Name="Footer" Text="原有软件保持开启；本轮新增后台自动释放。运行时请勿修改DQ批量方案。" Style="{DynamicResource Small}" Margin="1,16,0,0" LineHeight="19"/>
   </StackPanel></ScrollViewer>
 </Grid></Border>
</Window>
